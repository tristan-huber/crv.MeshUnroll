      ],
      "interpreterVersion": 1,
      "code": "// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(\n  surface: Assembly,\n  tolerance: number = 0.01,\n  asSingular: boolean = false,\n  maxTensileStrain: number = 0.05,\n  maxCompressiveStrain: number = 0.05,\n): Assembly {\n  const toUnroll: { srcLeaf: Assembly; mesh: Mesh }[] = [];\n  surface.onLeafs((leaf) => {\n    const sface = leaf.getSelectedFaces().filter((f) => f != undefined);\n    if (sface.length > 0) {\n      toUnroll.push(\n        ...sface.map((f) => {\n          return { srcLeaf: leaf, mesh: faceToMesh(f, tolerance) };\n        }),\n      );\n    } else if (leaf.geometry instanceof replicad.Face) {\n      toUnroll.push({\n        srcLeaf: leaf,\n        mesh: faceToMesh(leaf.geometry, tolerance),\n      });\n    }\n    return leaf;\n  });\n  if (toUnroll.length == 0) {\n    throw new Error(\"No selected faces, and not an assembly of face geoms\");\n  }\n\n  if (asSingular) {\n    // Group selected faces that share an edge into one mesh so they unroll\n    // as a single continuous surface; faces with no shared edge stay separate.\n    const islands = combineMeshes(toUnroll.map((t) => t.mesh));\n    let ybuffer = 0;\n    const result = islands.map((foo) => {\n      const unrolled = unrollArap(foo);\n      const distortion = measureDistortion(foo, unrolled);\n      console.log(distortion.triStrains.length);\n      console.log(foo.tris.length);\n      console.log(\n        `pointref range. input mesh: ${foo.positions.length} result mesh: ${unrolled.positions.length}`,\n      );\n      const drawing = unrolledWithHoles(unrolled).translate(0, ybuffer);\n      const meshOverride = buildHeatmapMeshOverride(\n        foo,\n        unrolled,\n        distortion.triStrains,\n        maxTensileStrain,\n        maxCompressiveStrain,\n        ybuffer,\n      );\n      ybuffer += drawing.boundingBox.height * 1.1;\n      return new Assembly({\n        geometry: drawing,\n        metadata: {\n          meshOverride,\n        },\n      });\n    });\n    return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n  } else {\n    let ybuffer = 0;\n    const result = toUnroll.map((leaf) => {\n      const unrollResult = unrollArap(leaf.mesh);\n      const distortion = measureDistortion(leaf.mesh, unrollResult);\n      const drawing = unrolledWithHoles(unrollResult).translate(0, ybuffer);\n      const meshOverride = buildHeatmapMeshOverride(\n        leaf.mesh,\n        unrollResult,\n        distortion.triStrains,\n        maxTensileStrain,\n        maxCompressiveStrain,\n        ybuffer,\n      );\n      ybuffer += drawing.boundingBox.height * 1.1;\n      return new Assembly({\n        ...leaf.srcLeaf,\n        geometry: drawing,\n        metadata: {\n          ...leaf.srcLeaf.metadata,\n          meshOverride,\n        },\n      });\n    });\n    return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n  }\n}\n\nfunction unrolledWithHoles(unrolResult: FlatMesh): replicad.Drawing {\n  let res = xysToClosedDrawing(unrolResult.outline);\n  unrolResult.innerWires.forEach((inner: Point2D[]) => {\n    res = res.cut(xysToClosedDrawing(inner));\n  });\n  return res;\n}\n\nfunction buildHeatmapMeshOverride(\n  mesh: Mesh,\n  flat: FlatMesh,\n  triStrains: { e1: number; e2: number }[],\n  maxTensileStrain: number,\n  maxCompressiveStrain: number,\n  yOffset: number = 0,\n) {\n  const vertices: number[] = [];\n  const triangles: number[] = [];\n  const vertexColors: number[] = [];\n\n  mesh.tris.forEach((tri, triIndex) => {\n    const { e1, e2 } = triStrains[triIndex] ?? { e1: 0, e2: 0 };\n    const tensionRisk = e1 > 0 ? e1 / maxTensileStrain : 0;\n    const compressionRisk = e2 < 0 ? -e2 / maxCompressiveStrain : 0;\n    const [r, g, b] = riskToRgb(tensionRisk, compressionRisk);\n    const baseIndex = vertices.length / 3;\n\n    tri.forEach((vertexIndex) => {\n      const point = flat.positions[vertexIndex];\n      vertices.push(point.x, point.y + yOffset, 0);\n      vertexColors.push(r, g, b);\n    });\n\n    triangles.push(baseIndex, baseIndex + 1, baseIndex + 2);\n  });\n\n  return {\n    faces: {\n      vertices,\n      triangles,\n    },\n    vertexColors,\n  };\n}\n\n// 0 = no distortion (white), 1 = exactly at the material's strain limit\n// (solid color); clamped for anything past the limit since it's already\n// unsafe. Tension (stretch) ramps toward red, compression (shrink) toward\n// blue; whichever risk is larger for a triangle determines its hue.\nfunction riskToRgb(\n  tensionRisk: number,\n  compressionRisk: number,\n): [number, number, number] {\n  if (tensionRisk >= compressionRisk) {\n    const t = Math.max(0, Math.min(1, tensionRisk));\n    return [1, 1 - t, 1 - t];\n  }\n  const t = Math.max(0, Math.min(1, compressionRisk));\n  return [1 - t, 1 - t, 1];\n}\n\n// Groups meshes that share a boundary edge into a single combined mesh (so\n// they flatten together as one continuous surface); meshes with no shared\n// edge are left as separate entries. Vertex dedup uses a hashed key (not\n// pairwise comparison) and connectivity is derived from edges that are\n// naked in more than one input mesh, so this runs in roughly\n// O(points + triangles) total rather than the prior O(tris^2 * meshCount).\nfunction combineMeshes(meshes: Mesh[]): Mesh[] {\n  if (meshes.length <= 1) return meshes;\n\n  // Dedup points across all meshes into one global vertex list.\n  const globalPositions: Point3D[] = [];\n  const globalIndexByKey = new Map<string, number>();\n  const keyOf = (p: Point3D) =>\n    `${p.x.toFixed(6)}_${p.y.toFixed(6)}_${p.z.toFixed(6)}`;\n  const remappedTris: Tri3[][] = meshes.map((mesh) => {\n    const localToGlobal = mesh.positions.map((p) => {\n      const key = keyOf(p);\n      let idx = globalIndexByKey.get(key);\n      if (idx === undefined) {\n        idx = globalPositions.length;\n        globalPositions.push(p);\n        globalIndexByKey.set(key, idx);\n      }\n      return idx;\n    });\n    return mesh.tris.map((tri) => tri.map((i) => localToGlobal[i]) as Tri3);\n  });\n\n  // Union meshes that share a boundary edge: an edge naked in two different\n  // input meshes becomes internal once those meshes are combined.\n  const parent = meshes.map((_, i) => i);\n  const find = (i: number): number => {\n    if (parent[i] !== i) parent[i] = find(parent[i]);\n    return parent[i];\n  };\n  const union = (a: number, b: number) => {\n    const ra = find(a);\n    const rb = find(b);\n    if (ra !== rb) parent[ra] = rb;\n  };\n\n  const edgeKey = (a: number, b: number) => (a < b ? `${a}_${b}` : `${b}_${a}`);\n  const edgeOwner = new Map<string, number>();\n  remappedTris.forEach((tris, meshIndex) => {\n    const boundary = boundaryEdges({ positions: globalPositions, tris });\n    for (const [a, b] of boundary) {\n      const key = edgeKey(a, b);\n      const owner = edgeOwner.get(key);\n      if (owner === undefined) {\n        edgeOwner.set(key, meshIndex);\n      } else if (owner !== meshIndex) {\n        union(owner, meshIndex);\n      }\n    }\n  });\n\n  // Group mesh indices by connected component, then rebuild a compact mesh\n  // (deduped positions, remapped triangle indices) per component.\n  const groups = new Map<number, number[]>();\n  meshes.forEach((_, i) => {\n    const root = find(i);\n    const group = groups.get(root);\n    if (group) group.push(i);\n    else groups.set(root, [i]);\n  });\n\n  return Array.from(groups.values()).map((meshIndices) => {\n    const compactIndex = new Map<number, number>();\n    const positions: Point3D[] = [];\n    const tris: Tri3[] = [];\n    meshIndices.forEach((meshIndex) => {\n      remappedTris[meshIndex].forEach((tri) => {\n        tris.push(\n          tri.map((globalIdx) => {\n            let local = compactIndex.get(globalIdx);\n            if (local === undefined) {\n              local = positions.length;\n              positions.push(globalPositions[globalIdx]);\n              compactIndex.set(globalIdx, local);\n            }\n            return local;\n          }) as Tri3,\n        );\n      });\n    });\n    return { positions, tris };\n  });\n}\n\nfunction faceToMesh(face: replicad.Face, tolerance: number): Mesh {\n  const replMesh = face.mesh({ tolerance: tolerance, angularTolerance: 0.1 });\n  // translate\n  const points: Point3D[] = [];\n  const v = replMesh.vertices;\n  for (let i = 0; i < v.length; i += 3) {\n    points.push({ x: v[i], y: v[i + 1], z: v[i + 2] });\n  }\n  const tris: Tri3[] = [];\n  const t = replMesh.triangles;\n  for (let i = 0; i < t.length; i += 3) {\n    tris.push([t[i], t[i + 1], t[i + 2]]);\n  }\n  return { positions: points, tris: tris };\n}\n\nfunction xysToClosedDrawing(points: Point2D[]) {\n  const pen = replicad.draw([points[0].x, points[0].y]);\n  for (let i = 1; i < points.length; i++) {\n    pen.lineTo([points[i].x, points[i].y]);\n  }\n  return pen.close();\n}\n\nexport type Point2D = { x: number; y: number };\nexport type Point3D = { x: number; y: number; z: number };\n\nexport type Tri3 = [number, number, number];\n\nexport type Mesh = {\n  positions: Point3D[];\n  tris: Tri3[];\n};\n\nexport type FlatMesh = {\n  positions: Point2D[];\n  outline: Point2D[];\n  innerWires: Point2D[][];\n};\n\nexport type Unroller = (mesh: Mesh) => FlatMesh;\n\nconst COT_MIN = 0.05;\nconst COT_MAX = 20;\n\nconst ITERATIONS = 4000;\n\nconst SETTLED = 1e-6;\n\ntype Adj = { j: number; w: number; t: number; dx: number; dy: number };\n\nexport function unrollArap(mesh: Mesh): FlatMesh {\n  const tris = buildTris(mesh);\n  const nv = mesh.positions.length;\n  const flat = placeByUnfolding(mesh, tris);\n\n  if (tris.length > 0 && nv > 1) {\n    const { adj, triW } = buildAdjacency(tris, nv);\n    solve(flat, tris, adj, triW);\n  }\n\n  const positions = canonicalise(flat);\n  const edges = boundaryLoop(mesh).map((wire) => wire.map((i) => positions[i]));\n  return { positions, outline: edges[0], innerWires: edges.slice(1) };\n}\n\nfunction buildAdjacency(\n  tris: Tri[],\n  nv: number,\n): { adj: Adj[][]; triW: Float64Array } {\n  const adj: Adj[][] = [];\n  const triW = new Float64Array(tris.length * 3);\n  for (let i = 0; i < nv; i++) adj.push([]);\n\n  tris.forEach((tri, t) => {\n    const { ids, xs } = tri;\n    const twoArea = 2 * tri.area;\n    for (let e = 0; e < 3; e++) {\n      const p = e;\n      const q = (e + 1) % 3;\n      const o = (e + 2) % 3;\n      const ax = xs[p].x - xs[o].x,\n        ay = xs[p].y - xs[o].y;\n      const bx = xs[q].x - xs[o].x,\n        by = xs[q].y - xs[o].y;\n\n      const cot = twoArea > 0 ? (ax * bx + ay * by) / twoArea : COT_MIN;\n      const w = Math.min(COT_MAX, Math.max(COT_MIN, cot));\n      triW[t * 3 + e] = w;\n      const dx = xs[p].x - xs[q].x;\n      const dy = xs[p].y - xs[q].y;\n      adj[ids[p]].push({ j: ids[q], w, t, dx, dy });\n      adj[ids[q]].push({ j: ids[p], w, t, dx: -dx, dy: -dy });\n    }\n  });\n  return { adj, triW };\n}\n\nfunction solve(flat: Point2D[], tris: Tri[], adj: Adj[][], triW: Float64Array) {\n  const nv = flat.length;\n  const cos = new Float64Array(tris.length);\n  const sin = new Float64Array(tris.length);\n  const tol = SETTLED * intrinsicScale(tris);\n  const system = factorSystem(adj, nv);\n\n  const bestX = new Float64Array(nv);\n  const bestY = new Float64Array(nv);\n  let bestE = energyOf(flat, tris);\n  snapshot(flat, bestX, bestY);\n\n  const rx = new Float64Array(Math.max(nv - 1, 0));\n  const ry = new Float64Array(Math.max(nv - 1, 0));\n\n  for (let it = 0; it < ITERATIONS; it++) {\n    localStep(flat, tris, triW, cos, sin);\n\n    let maxDelta = 0;\n    if (system) {\n      rx.fill(0);\n      ry.fill(0);\n      for (let i = 1; i < nv; i++) {\n        let bx = 0;\n        let by = 0;\n        for (const e of adj[i]) {\n          bx += e.w * (cos[e.t] * e.dx - sin[e.t] * e.dy);\n          by += e.w * (sin[e.t] * e.dx + cos[e.t] * e.dy);\n          if (e.j === 0) {\n            bx += e.w * flat[0].x;\n            by += e.w * flat[0].y;\n          }\n        }\n        rx[i - 1] = bx;\n        ry[i - 1] = by;\n      }\n      solveBanded(system, rx, ry);\n      for (let i = 1; i < nv; i++) {\n        const d = Math.hypot(rx[i - 1] - flat[i].x, ry[i - 1] - flat[i].y);\n        if (d > maxDelta) maxDelta = d;\n        flat[i].x = rx[i - 1];\n        flat[i].y = ry[i - 1];\n      }\n    } else {\n      maxDelta = gaussSeidel(flat, adj, cos, sin, nv);\n    }\n\n    const e = energyOf(flat, tris);\n    if (e < bestE) {\n      bestE = e;\n      snapshot(flat, bestX, bestY);\n    }\n    if (maxDelta < tol) break;\n  }\n\n  restore(flat, bestX, bestY);\n}\n\nfunction snapshot(flat: Point2D[], x: Float64Array, y: Float64Array) {\n  for (let i = 0; i < flat.length; i++) {\n    if (flat[i] == undefined) {\n      continue;\n    }\n    x[i] = flat[i].x;\n    y[i] = flat[i].y;\n  }\n}\n\nfunction restore(flat: Point2D[], x: Float64Array, y: Float64Array) {\n  for (let i = 0; i < flat.length; i++) {\n    flat[i] = { x: x[i], y: y[i] };\n  }\n}\n\nfunction localStep(\n  flat: Point2D[],\n  tris: Tri[],\n  triW: Float64Array,\n  cos: Float64Array,\n  sin: Float64Array,\n) {\n  tris.forEach((tri, t) => {\n    const { ids, xs } = tri;\n    let num = 0;\n    let den = 0;\n    for (let e = 0; e < 3; e++) {\n      const p = e;\n      const q = (e + 1) % 3;\n      const w = triW[t * 3 + e];\n      const dxc = xs[q].x - xs[p].x;\n      const dyc = xs[q].y - xs[p].y;\n      const dqx = flat[ids[q]].x - flat[ids[p]].x;\n      const dqy = flat[ids[q]].y - flat[ids[p]].y;\n      num += w * (dqy * dxc - dqx * dyc);\n      den += w * (dqx * dxc + dqy * dyc);\n    }\n    const th = Math.atan2(num, den);\n    cos[t] = Math.cos(th);\n    sin[t] = Math.sin(th);\n  });\n}\n\nfunction gaussSeidel(\n  flat: Point2D[],\n  adj: Adj[][],\n  cos: Float64Array,\n  sin: Float64Array,\n  nv: number,\n): number {\n  let maxDelta = 0;\n  for (let sweep = 0; sweep < 3; sweep++) {\n    for (let i = 1; i < nv; i++) {\n      let diag = 0;\n      let sx = 0;\n      let sy = 0;\n      for (const e of adj[i]) {\n        diag += e.w;\n        sx += e.w * (flat[e.j].x + cos[e.t] * e.dx - sin[e.t] * e.dy);\n        sy += e.w * (flat[e.j].y + sin[e.t] * e.dx + cos[e.t] * e.dy);\n      }\n      if (diag <= 0) continue;\n      const nx = sx / diag;\n      const ny = sy / diag;\n      const d = Math.hypot(nx - flat[i].x, ny - flat[i].y);\n      if (d > maxDelta) maxDelta = d;\n      flat[i] = { x: nx, y: ny };\n    }\n  }\n  return maxDelta;\n}\n\ntype Banded = { n: number; b: number; a: Float64Array; envelope: Int32Array };\n\nfunction factorSystem(adj: Adj[][], nv: number): Banded | null {\n  const n = nv - 1;\n  if (n <= 0) return null;\n\n  let b = 0;\n  for (let i = 1; i < nv; i++) {\n    for (const e of adj[i]) {\n      if (e.j === 0) continue;\n      const d = Math.abs(i - e.j);\n      if (d > b) b = d;\n    }\n  }\n  if (b >= n) return null;\n\n  const a = new Float64Array(n * (b + 1));\n  for (let i = 1; i < nv; i++) {\n    const r = i - 1;\n    for (const e of adj[i]) {\n      a[r * (b + 1)] += e.w;\n      if (e.j === 0) continue;\n      const c = e.j - 1;\n      if (c < r) a[r * (b + 1) + (r - c)] -= e.w;\n    }\n  }\n\n  const envelope = new Int32Array(n);\n  for (let r = 0; r < n; r++) {\n    const top = Math.min(b, r);\n    for (let k = top; k >= 1; k--) {\n      if (a[r * (b + 1) + k] !== 0) {\n        envelope[r] = k;\n        break;\n      }\n    }\n  }\n\n  for (let i = 0; i < n; i++) {\n    const wi = envelope[i];\n    for (let k = wi; k >= 1; k--) {\n      const j = i - k;\n      if (j < 0) continue;\n      let s = a[i * (b + 1) + k];\n      const top = Math.min(wi - k, envelope[j]);\n      for (let m = 1; m <= top; m++) {\n        s -= a[i * (b + 1) + (k + m)] * a[j * (b + 1) + m];\n      }\n      a[i * (b + 1) + k] = s / a[j * (b + 1)];\n    }\n    let d = a[i * (b + 1)];\n    for (let k = 1; k <= wi; k++) {\n      d -= a[i * (b + 1) + k] * a[i * (b + 1) + k];\n    }\n    if (!(d > 0)) return null;\n    a[i * (b + 1)] = Math.sqrt(d);\n  }\n  return { n, b, a, envelope };\n}\n\nfunction solveBanded(m: Banded, rx: Float64Array, ry: Float64Array) {\n  const { n, b, a, envelope } = m;\n  const w = b + 1;\n  for (let i = 0; i < n; i++) {\n    let sx = rx[i];\n    let sy = ry[i];\n    const wi = envelope[i];\n    for (let k = 1; k <= wi; k++) {\n      const v = a[i * w + k];\n      sx -= v * rx[i - k];\n      sy -= v * ry[i - k];\n    }\n    const d = a[i * w];\n    rx[i] = sx / d;\n    ry[i] = sy / d;\n  }\n  for (let i = n - 1; i >= 0; i--) {\n    const d = a[i * w];\n    const vx = rx[i] / d;\n    const vy = ry[i] / d;\n    rx[i] = vx;\n    ry[i] = vy;\n    const wi = envelope[i];\n    for (let k = 1; k <= wi; k++) {\n      const v = a[i * w + k];\n      rx[i - k] -= v * vx;\n      ry[i - k] -= v * vy;\n    }\n  }\n}\n\nfunction intrinsicScale(tris: Tri[]): number {\n  let area = 0;\n  for (const tri of tris) area += tri.area;\n  return area > 0 ? Math.sqrt(area) : 1;\n}\n\nexport type Tri = {\n  ids: Tri3;\n  xs: [Point2D, Point2D, Point2D];\n  area: number;\n};\n\nexport function buildTris(mesh: Mesh): Tri[] {\n  const out: Tri[] = [];\n  for (const [a, b, c] of mesh.tris) {\n    const A = mesh.positions[a];\n    const B = mesh.positions[b];\n    const C = mesh.positions[c];\n    const ux = B.x - A.x,\n      uy = B.y - A.y,\n      uz = B.z - A.z;\n    const vx = C.x - A.x,\n      vy = C.y - A.y,\n      vz = C.z - A.z;\n    const cx = uy * vz - uz * vy;\n    const cy = uz * vx - ux * vz;\n    const cz = ux * vy - uy * vx;\n    const cross = Math.hypot(cx, cy, cz);\n    const la = Math.hypot(ux, uy, uz);\n    const lb = Math.hypot(vx, vy, vz);\n    if (la === 0 || lb === 0) continue;\n    const cos = Math.max(\n      -1,\n      Math.min(1, (ux * vx + uy * vy + uz * vz) / (la * lb)),\n    );\n    out.push({\n      ids: [a, b, c],\n      xs: [\n        { x: 0, y: 0 },\n        { x: la, y: 0 },\n        { x: lb * cos, y: lb * Math.sqrt(Math.max(0, 1 - cos * cos)) },\n      ],\n      area: cross / 2,\n    });\n  }\n  return out;\n}\n\nexport function energyOf(flat: Point2D[], tris: Tri[]): number {\n  let e = 0;\n  let area = 0;\n  for (const tri of tris) {\n    const { ids, xs } = tri;\n    for (let k = 0; k < 3; k++) {\n      const p = k;\n      const q = (k + 1) % 3;\n      const lc = Math.hypot(xs[q].x - xs[p].x, xs[q].y - xs[p].y);\n      const lq = Math.hypot(\n        flat[ids[q]].x - flat[ids[p]].x,\n        flat[ids[q]].y - flat[ids[p]].y,\n      );\n      e += (lq - lc) * (lq - lc);\n    }\n    area += tri.area;\n  }\n  return area > 0 ? e / area : 0;\n}\n\nexport function placeByUnfolding(mesh: Mesh, tris: Tri[]): Point2D[] {\n  const nv = mesh.positions.length;\n  const flat: Point2D[] = new Array(nv);\n  const placed: boolean[] = new Array(nv).fill(false);\n\n  const incident: number[][] = [];\n  for (let i = 0; i < nv; i++) incident.push([]);\n  tris.forEach((tri, t) => {\n    for (const id of tri.ids) incident[id].push(t);\n  });\n\n  const seed = tris[0];\n  seed.ids.forEach((id, k) => {\n    flat[id] = { x: seed.xs[k].x, y: seed.xs[k].y };\n    placed[id] = true;\n  });\n\n  const queue: number[] = seed.ids.flatMap((id) => incident[id]);\n  for (let head = 0; head < queue.length; head++) {\n    const tri = tris[queue[head]];\n    const open = tri.ids.filter((i) => !placed[i]);\n    if (open.length !== 1) continue;\n    const v = open[0];\n    const p = placeFrom(\n      bestHinge(v, incident[v], tris, placed, tri),\n      v,\n      flat,\n      placed,\n    );\n    if (!p) continue;\n    flat[v] = p;\n    placed[v] = true;\n    for (const t of incident[v]) queue.push(t);\n  }\n\n  for (let i = 0; i < nv; i++) {\n    if (!placed[i])\n      console.warn(`unroll: vertex ${i} of ${nv} is not connected to the mesh`);\n  }\n  return flat;\n}\n\nfunction bestHinge(\n  v: number,\n  candidates: number[],\n  tris: Tri[],\n  placed: boolean[],\n  fallback: Tri,\n): Tri {\n  let best = fallback;\n  let bestScore = -Infinity;\n  for (const t of candidates) {\n    const tri = tris[t];\n    const k = tri.ids.indexOf(v);\n    if (k < 0) continue;\n    const i = (k + 1) % 3;\n    const j = (k + 2) % 3;\n    if (!placed[tri.ids[i]] || !placed[tri.ids[j]]) continue;\n    const edge = sq(tri.xs[j].x - tri.xs[i].x, tri.xs[j].y - tri.xs[i].y);\n    const reach = sq(tri.xs[k].x - tri.xs[i].x, tri.xs[k].y - tri.xs[i].y);\n    const score = reach > 0 ? edge / reach : Infinity;\n    if (score > bestScore) {\n      bestScore = score;\n      best = tri;\n    }\n  }\n  return best;\n}\n\nfunction sq(dx: number, dy: number): number {\n  return dx * dx + dy * dy;\n}\n\nfunction placeFrom(\n  tri: Tri,\n  v: number,\n  flat: Point2D[],\n  placed: boolean[],\n): Point2D | null {\n  const { ids, xs } = tri;\n  const k = ids.indexOf(v);\n  const i = (k + 1) % 3;\n  const j = (k + 2) % 3;\n  if (!placed[ids[i]] || !placed[ids[j]]) return null;\n\n  const dx = xs[j].x - xs[i].x;\n  const dy = xs[j].y - xs[i].y;\n  const den = dx * dx + dy * dy;\n  if (den < 1e-12) return null;\n  const ex = flat[ids[j]].x - flat[ids[i]].x;\n  const ey = flat[ids[j]].y - flat[ids[i]].y;\n  const sr = (ex * dx + ey * dy) / den;\n  const si = (ey * dx - ex * dy) / den;\n  const norm = Math.hypot(sr, si);\n  if (norm < 1e-12) return null;\n  const cr = sr / norm;\n  const ci = si / norm;\n  const vx = xs[k].x - xs[i].x;\n  const vy = xs[k].y - xs[i].y;\n  return {\n    x: flat[ids[i]].x + cr * vx - ci * vy,\n    y: flat[ids[i]].y + ci * vx + cr * vy,\n  };\n}\n\nexport function canonicalise(flat: Point2D[]): Point2D[] {\n  if (flat.length === 0) return flat;\n  let cx = 0;\n  let cy = 0;\n  for (const p of flat) {\n    cx += p.x;\n    cy += p.y;\n  }\n  cx /= flat.length;\n  cy /= flat.length;\n\n  let sxx = 0;\n  let sxy = 0;\n  let syy = 0;\n  for (const p of flat) {\n    const dx = p.x - cx;\n    const dy = p.y - cy;\n    sxx += dx * dx;\n    sxy += dx * dy;\n    syy += dy * dy;\n  }\n  const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy);\n  const co = Math.cos(-ang);\n  const si = Math.sin(-ang);\n\n  let minX = Infinity;\n  let minY = Infinity;\n  const out = flat.map((p) => {\n    const dx = p.x - cx;\n    const dy = p.y - cy;\n    const q = { x: co * dx - si * dy, y: si * dx + co * dy };\n    if (q.x < minX) minX = q.x;\n    if (q.y < minY) minY = q.y;\n    return q;\n  });\n  for (const q of out) {\n    q.x -= minX;\n    q.y -= minY;\n  }\n  return out;\n}\n\nexport function boundaryEdges(mesh: Mesh): [number, number][] {\n  const used = new Map<string, number>();\n  const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);\n\n  for (const [a, b, c] of mesh.tris) {\n    for (const [u, v] of [\n      [a, b],\n      [b, c],\n      [c, a],\n    ]) {\n      used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1);\n    }\n  }\n\n  const out: [number, number][] = [];\n  for (const [a, b, c] of mesh.tris) {\n    for (const [u, v] of [\n      [a, b],\n      [b, c],\n      [c, a],\n    ] as [number, number][]) {\n      if (used.get(key(u, v)) === 1) out.push([u, v]);\n    }\n  }\n  return out;\n}\n\nexport function chainEdges(edges: [number, number][]): number[][] {\n  const next = new Map<number, number>();\n  const hasPredecessor = new Set<number>();\n  for (const [u, v] of edges) {\n    next.set(u, v);\n    hasPredecessor.add(v);\n  }\n\n  const chains: number[][] = [];\n  const visited = new Set<number>();\n\n  const walk = (seed: number) => {\n    const chain = [seed];\n    visited.add(seed);\n    let cur = seed;\n    while (true) {\n      const to = next.get(cur);\n      if (to === undefined || to === seed) break;\n      if (visited.has(to)) break;\n      chain.push(to);\n      visited.add(to);\n      cur = to;\n    }\n\n    if (next.get(cur) === seed && chain.length > 2) chain.push(seed);\n    if (chain.length > 1) chains.push(chain);\n  };\n\n  for (const [u] of next) if (!hasPredecessor.has(u)) walk(u);\n  for (const [u] of next) if (!visited.has(u)) walk(u);\n  return chains;\n}\n\nexport function boundaryLoop(mesh: Mesh): number[][] {\n  const chains = chainEdges(boundaryEdges(mesh));\n  if (chains.length === 0) return [];\n  return chains.map((loop) => {\n    return loop[0] === loop[loop.length - 1] ? loop.slice(0, -1) : loop;\n  });\n}\n\n// Distortion measurements\nexport type Distortion = {\n  edgeRms: number;\n  edgeMax: number;\n  areaRatio: number;\n  triStrains: { e1: number; e2: number }[];\n};\n\nexport function measureDistortion(mesh: Mesh, flat: FlatMesh): Distortion {\n  let squared = 0;\n  let count = 0;\n  let edgeMax = 0;\n  let area3d = 0;\n  let area2d = 0;\n  const triStrains: { e1: number; e2: number }[] = [];\n\n  for (const [a, b, c] of mesh.tris) {\n    const local = flattenTriangle(mesh, a, b, c);\n    for (const [u, v] of [\n      [a, b],\n      [b, c],\n      [c, a],\n    ]) {\n      const length3d = distance3d(mesh, u, v);\n      if (length3d === 0) continue;\n      const p = flat.positions[u];\n      const q = flat.positions[v];\n      const ratio = Math.hypot(q.x - p.x, q.y - p.y) / length3d - 1;\n      squared += ratio * ratio;\n      count += 1;\n      edgeMax = Math.max(edgeMax, Math.abs(ratio));\n    }\n\n    area3d += local.area;\n    area2d += Math.abs(\n      signedArea(flat.positions[a], flat.positions[b], flat.positions[c]),\n    );\n    triStrains.push(principalStrains(local, flat, a, b, c));\n  }\n\n  return {\n    edgeRms: count > 0 ? Math.sqrt(squared / count) : 0,\n    edgeMax,\n    areaRatio: area3d > 0 ? area2d / area3d : 1,\n    triStrains,\n  };\n}\n\ntype LocalTriangle = { ux: number; vx: number; vy: number; area: number };\n\nfunction flattenTriangle(\n  mesh: Mesh,\n  a: number,\n  b: number,\n  c: number,\n): LocalTriangle {\n  const A = mesh.positions[a];\n  const B = mesh.positions[b];\n  const C = mesh.positions[c];\n  const ex = B.x - A.x,\n    ey = B.y - A.y,\n    ez = B.z - A.z;\n  const fx = C.x - A.x,\n    fy = C.y - A.y,\n    fz = C.z - A.z;\n  const ux = Math.hypot(ex, ey, ez);\n  const dot = ux > 0 ? (ex * fx + ey * fy + ez * fz) / ux : 0;\n  const nx = ey * fz - ez * fy;\n  const ny = ez * fx - ex * fz;\n  const nz = ex * fy - ey * fx;\n  const cross = Math.hypot(nx, ny, nz);\n  return { ux, vx: dot, vy: ux > 0 ? cross / ux : 0, area: cross / 2 };\n}\n\nfunction principalStrains(\n  local: LocalTriangle,\n  flat: FlatMesh,\n  a: number,\n  b: number,\n  c: number,\n): { e1: number; e2: number } {\n  const det = local.ux * local.vy;\n  if (det === 0) return { e1: 0, e2: 0 };\n\n  const A = flat.positions[a];\n  const B = flat.positions[b];\n  const C = flat.positions[c];\n  const qx1 = B.x - A.x,\n    qy1 = B.y - A.y;\n  const qx2 = C.x - A.x,\n    qy2 = C.y - A.y;\n\n  const i00 = local.vy / det;\n  const i01 = -local.vx / det;\n  const i11 = local.ux / det;\n\n  const j00 = qx1 * i00;\n  const j01 = qx1 * i01 + qx2 * i11;\n  const j10 = qy1 * i00;\n  const j11 = qy1 * i01 + qy2 * i11;\n\n  const e = (j00 + j11) / 2;\n  const f = (j00 - j11) / 2;\n  const g = (j10 + j01) / 2;\n  const h = (j10 - j01) / 2;\n  const q = Math.hypot(e, h);\n  const r = Math.hypot(f, g);\n  const sigma1 = q + r;\n  const sigma2 = Math.abs(q - r);\n  // sigma1 >= sigma2, so e1 (tension) is always >= e2 (compression)\n  return { e1: sigma1 - 1, e2: sigma2 - 1 };\n}\n\nfunction signedArea(\n  a: { x: number; y: number },\n  b: { x: number; y: number },\n  c: { x: number; y: number },\n): number {\n  return ((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)) / 2;\n}\n\nfunction distance3d(mesh: Mesh, u: number, v: number): number {\n  const p = mesh.positions[u];\n  const q = mesh.positions[v];\n  return Math.hypot(q.x - p.x, q.y - p.y, q.z - p.z);\n}\n",
      "compiledCode": "// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(surface, tolerance = 0.01, asSingular = false, maxTensileStrain = 0.05, maxCompressiveStrain = 0.05) {\n    const toUnroll = [];\n    surface.onLeafs((leaf) => {\n        const sface = leaf.getSelectedFaces().filter((f) => f != undefined);\n        if (sface.length > 0) {\n            toUnroll.push(...sface.map((f) => {\n                return { srcLeaf: leaf, mesh: faceToMesh(f, tolerance) };\n            }));\n        }\n        else if (leaf.geometry instanceof replicad.Face) {\n            toUnroll.push({\n                srcLeaf: leaf,\n                mesh: faceToMesh(leaf.geometry, tolerance),\n            });\n        }\n        return leaf;\n    });\n    if (toUnroll.length == 0) {\n        throw new Error(\"No selected faces, and not an assembly of face geoms\");\n    }\n    if (asSingular) {\n        // Group selected faces that share an edge into one mesh so they unroll\n        // as a single continuous surface; faces with no shared edge stay separate.\n        const islands = combineMeshes(toUnroll.map((t) => t.mesh));\n        let ybuffer = 0;\n        const result = islands.map((foo) => {\n            const unrolled = unrollArap(foo);\n            const distortion = measureDistortion(foo, unrolled);\n            console.log(distortion.triStrains.length);\n            console.log(foo.tris.length);\n            console.log(`pointref range. input mesh: ${foo.positions.length} result mesh: ${unrolled.positions.length}`);\n            const drawing = unrolledWithHoles(unrolled).translate(0, ybuffer);\n            const meshOverride = buildHeatmapMeshOverride(foo, unrolled, distortion.triStrains, maxTensileStrain, maxCompressiveStrain, ybuffer);\n            ybuffer += drawing.boundingBox.height * 1.1;\n            return new Assembly({\n                geometry: drawing,\n                metadata: {\n                    meshOverride,\n                },\n            });\n        });\n        return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n    }\n    else {\n        let ybuffer = 0;\n        const result = toUnroll.map((leaf) => {\n            const unrollResult = unrollArap(leaf.mesh);\n            const distortion = measureDistortion(leaf.mesh, unrollResult);\n            const drawing = unrolledWithHoles(unrollResult).translate(0, ybuffer);\n            const meshOverride = buildHeatmapMeshOverride(leaf.mesh, unrollResult, distortion.triStrains, maxTensileStrain, maxCompressiveStrain, ybuffer);\n            ybuffer += drawing.boundingBox.height * 1.1;\n            return new Assembly({\n                ...leaf.srcLeaf,\n                geometry: drawing,\n                metadata: {\n                    ...leaf.srcLeaf.metadata,\n                    meshOverride,\n                },\n            });\n        });\n        return new Assembly({ geometry: result.flat() }).skipDisjointPostprocess();\n    }\n}\nfunction unrolledWithHoles(unrolResult) {\n    let res = xysToClosedDrawing(unrolResult.outline);\n    unrolResult.innerWires.forEach((inner) => {\n        res = res.cut(xysToClosedDrawing(inner));\n    });\n    return res;\n}\nfunction buildHeatmapMeshOverride(mesh, flat, triStrains, maxTensileStrain, maxCompressiveStrain, yOffset = 0) {\n    const vertices = [];\n    const triangles = [];\n    const vertexColors = [];\n    mesh.tris.forEach((tri, triIndex) => {\n        const { e1, e2 } = triStrains[triIndex] ?? { e1: 0, e2: 0 };\n        const tensionRisk = e1 > 0 ? e1 / maxTensileStrain : 0;\n        const compressionRisk = e2 < 0 ? -e2 / maxCompressiveStrain : 0;\n        const [r, g, b] = riskToRgb(tensionRisk, compressionRisk);\n        const baseIndex = vertices.length / 3;\n        tri.forEach((vertexIndex) => {\n            const point = flat.positions[vertexIndex];\n            vertices.push(point.x, point.y + yOffset, 0);\n            vertexColors.push(r, g, b);\n        });\n        triangles.push(baseIndex, baseIndex + 1, baseIndex + 2);\n    });\n    return {\n        faces: {\n            vertices,\n            triangles,\n        },\n        vertexColors,\n    };\n}\n// 0 = no distortion (white), 1 = exactly at the material's strain limit\n// (solid color); clamped for anything past the limit since it's already\n// unsafe. Tension (stretch) ramps toward red, compression (shrink) toward\n// blue; whichever risk is larger for a triangle determines its hue.\nfunction riskToRgb(tensionRisk, compressionRisk) {\n    if (tensionRisk >= compressionRisk) {\n        const t = Math.max(0, Math.min(1, tensionRisk));\n        return [1, 1 - t, 1 - t];\n    }\n    const t = Math.max(0, Math.min(1, compressionRisk));\n    return [1 - t, 1 - t, 1];\n}\n// Groups meshes that share a boundary edge into a single combined mesh (so\n// they flatten together as one continuous surface); meshes with no shared\n// edge are left as separate entries. Vertex dedup uses a hashed key (not\n// pairwise comparison) and connectivity is derived from edges that are\n// naked in more than one input mesh, so this runs in roughly\n// O(points + triangles) total rather than the prior O(tris^2 * meshCount).\nfunction combineMeshes(meshes) {\n    if (meshes.length <= 1)\n        return meshes;\n    // Dedup points across all meshes into one global vertex list.\n    const globalPositions = [];\n    const globalIndexByKey = new Map();\n    const keyOf = (p) => `${p.x.toFixed(6)}_${p.y.toFixed(6)}_${p.z.toFixed(6)}`;\n    const remappedTris = meshes.map((mesh) => {\n        const localToGlobal = mesh.positions.map((p) => {\n            const key = keyOf(p);\n            let idx = globalIndexByKey.get(key);\n            if (idx === undefined) {\n                idx = globalPositions.length;\n                globalPositions.push(p);\n                globalIndexByKey.set(key, idx);\n            }\n            return idx;\n        });\n        return mesh.tris.map((tri) => tri.map((i) => localToGlobal[i]));\n    });\n    // Union meshes that share a boundary edge: an edge naked in two different\n    // input meshes becomes internal once those meshes are combined.\n    const parent = meshes.map((_, i) => i);\n    const find = (i) => {\n        if (parent[i] !== i)\n            parent[i] = find(parent[i]);\n        return parent[i];\n    };\n    const union = (a, b) => {\n        const ra = find(a);\n        const rb = find(b);\n        if (ra !== rb)\n            parent[ra] = rb;\n    };\n    const edgeKey = (a, b) => (a < b ? `${a}_${b}` : `${b}_${a}`);\n    const edgeOwner = new Map();\n    remappedTris.forEach((tris, meshIndex) => {\n        const boundary = boundaryEdges({ positions: globalPositions, tris });\n        for (const [a, b] of boundary) {\n            const key = edgeKey(a, b);\n            const owner = edgeOwner.get(key);\n            if (owner === undefined) {\n                edgeOwner.set(key, meshIndex);\n            }\n            else if (owner !== meshIndex) {\n                union(owner, meshIndex);\n            }\n        }\n    });\n    // Group mesh indices by connected component, then rebuild a compact mesh\n    // (deduped positions, remapped triangle indices) per component.\n    const groups = new Map();\n    meshes.forEach((_, i) => {\n        const root = find(i);\n        const group = groups.get(root);\n        if (group)\n            group.push(i);\n        else\n            groups.set(root, [i]);\n    });\n    return Array.from(groups.values()).map((meshIndices) => {\n        const compactIndex = new Map();\n        const positions = [];\n        const tris = [];\n        meshIndices.forEach((meshIndex) => {\n            remappedTris[meshIndex].forEach((tri) => {\n                tris.push(tri.map((globalIdx) => {\n                    let local = compactIndex.get(globalIdx);\n                    if (local === undefined) {\n                        local = positions.length;\n                        positions.push(globalPositions[globalIdx]);\n                        compactIndex.set(globalIdx, local);\n                    }\n                    return local;\n                }));\n            });\n        });\n        return { positions, tris };\n    });\n}\nfunction faceToMesh(face, tolerance) {\n    const replMesh = face.mesh({ tolerance: tolerance, angularTolerance: 0.1 });\n    // translate\n    const points = [];\n    const v = replMesh.vertices;\n    for (let i = 0; i < v.length; i += 3) {\n        points.push({ x: v[i], y: v[i + 1], z: v[i + 2] });\n    }\n    const tris = [];\n    const t = replMesh.triangles;\n    for (let i = 0; i < t.length; i += 3) {\n        tris.push([t[i], t[i + 1], t[i + 2]]);\n    }\n    return { positions: points, tris: tris };\n}\nfunction xysToClosedDrawing(points) {\n    const pen = replicad.draw([points[0].x, points[0].y]);\n    for (let i = 1; i < points.length; i++) {\n        pen.lineTo([points[i].x, points[i].y]);\n    }\n    return pen.close();\n}\nconst COT_MIN = 0.05;\nconst COT_MAX = 20;\nconst ITERATIONS = 4000;\nconst SETTLED = 1e-6;\nexport function unrollArap(mesh) {\n    const tris = buildTris(mesh);\n    const nv = mesh.positions.length;\n    const flat = placeByUnfolding(mesh, tris);\n    if (tris.length > 0 && nv > 1) {\n        const { adj, triW } = buildAdjacency(tris, nv);\n        solve(flat, tris, adj, triW);\n    }\n    const positions = canonicalise(flat);\n    const edges = boundaryLoop(mesh).map((wire) => wire.map((i) => positions[i]));\n    return { positions, outline: edges[0], innerWires: edges.slice(1) };\n}\nfunction buildAdjacency(tris, nv) {\n    const adj = [];\n    const triW = new Float64Array(tris.length * 3);\n    for (let i = 0; i < nv; i++)\n        adj.push([]);\n    tris.forEach((tri, t) => {\n        const { ids, xs } = tri;\n        const twoArea = 2 * tri.area;\n        for (let e = 0; e < 3; e++) {\n            const p = e;\n            const q = (e + 1) % 3;\n            const o = (e + 2) % 3;\n            const ax = xs[p].x - xs[o].x, ay = xs[p].y - xs[o].y;\n            const bx = xs[q].x - xs[o].x, by = xs[q].y - xs[o].y;\n            const cot = twoArea > 0 ? (ax * bx + ay * by) / twoArea : COT_MIN;\n            const w = Math.min(COT_MAX, Math.max(COT_MIN, cot));\n            triW[t * 3 + e] = w;\n            const dx = xs[p].x - xs[q].x;\n            const dy = xs[p].y - xs[q].y;\n            adj[ids[p]].push({ j: ids[q], w, t, dx, dy });\n            adj[ids[q]].push({ j: ids[p], w, t, dx: -dx, dy: -dy });\n        }\n    });\n    return { adj, triW };\n}\nfunction solve(flat, tris, adj, triW) {\n    const nv = flat.length;\n    const cos = new Float64Array(tris.length);\n    const sin = new Float64Array(tris.length);\n    const tol = SETTLED * intrinsicScale(tris);\n    const system = factorSystem(adj, nv);\n    const bestX = new Float64Array(nv);\n    const bestY = new Float64Array(nv);\n    let bestE = energyOf(flat, tris);\n    snapshot(flat, bestX, bestY);\n    const rx = new Float64Array(Math.max(nv - 1, 0));\n    const ry = new Float64Array(Math.max(nv - 1, 0));\n    for (let it = 0; it < ITERATIONS; it++) {\n        localStep(flat, tris, triW, cos, sin);\n        let maxDelta = 0;\n        if (system) {\n            rx.fill(0);\n            ry.fill(0);\n            for (let i = 1; i < nv; i++) {\n                let bx = 0;\n                let by = 0;\n                for (const e of adj[i]) {\n                    bx += e.w * (cos[e.t] * e.dx - sin[e.t] * e.dy);\n                    by += e.w * (sin[e.t] * e.dx + cos[e.t] * e.dy);\n                    if (e.j === 0) {\n                        bx += e.w * flat[0].x;\n                        by += e.w * flat[0].y;\n                    }\n                }\n                rx[i - 1] = bx;\n                ry[i - 1] = by;\n            }\n            solveBanded(system, rx, ry);\n            for (let i = 1; i < nv; i++) {\n                const d = Math.hypot(rx[i - 1] - flat[i].x, ry[i - 1] - flat[i].y);\n                if (d > maxDelta)\n                    maxDelta = d;\n                flat[i].x = rx[i - 1];\n                flat[i].y = ry[i - 1];\n            }\n        }\n        else {\n            maxDelta = gaussSeidel(flat, adj, cos, sin, nv);\n        }\n        const e = energyOf(flat, tris);\n        if (e < bestE) {\n            bestE = e;\n            snapshot(flat, bestX, bestY);\n        }\n        if (maxDelta < tol)\n            break;\n    }\n    restore(flat, bestX, bestY);\n}\nfunction snapshot(flat, x, y) {\n    for (let i = 0; i < flat.length; i++) {\n        if (flat[i] == undefined) {\n            continue;\n        }\n        x[i] = flat[i].x;\n        y[i] = flat[i].y;\n    }\n}\nfunction restore(flat, x, y) {\n    for (let i = 0; i < flat.length; i++) {\n        flat[i] = { x: x[i], y: y[i] };\n    }\n}\nfunction localStep(flat, tris, triW, cos, sin) {\n    tris.forEach((tri, t) => {\n        const { ids, xs } = tri;\n        let num = 0;\n        let den = 0;\n        for (let e = 0; e < 3; e++) {\n            const p = e;\n            const q = (e + 1) % 3;\n            const w = triW[t * 3 + e];\n            const dxc = xs[q].x - xs[p].x;\n            const dyc = xs[q].y - xs[p].y;\n            const dqx = flat[ids[q]].x - flat[ids[p]].x;\n            const dqy = flat[ids[q]].y - flat[ids[p]].y;\n            num += w * (dqy * dxc - dqx * dyc);\n            den += w * (dqx * dxc + dqy * dyc);\n        }\n        const th = Math.atan2(num, den);\n        cos[t] = Math.cos(th);\n        sin[t] = Math.sin(th);\n    });\n}\nfunction gaussSeidel(flat, adj, cos, sin, nv) {\n    let maxDelta = 0;\n    for (let sweep = 0; sweep < 3; sweep++) {\n        for (let i = 1; i < nv; i++) {\n            let diag = 0;\n            let sx = 0;\n            let sy = 0;\n            for (const e of adj[i]) {\n                diag += e.w;\n                sx += e.w * (flat[e.j].x + cos[e.t] * e.dx - sin[e.t] * e.dy);\n                sy += e.w * (flat[e.j].y + sin[e.t] * e.dx + cos[e.t] * e.dy);\n            }\n            if (diag <= 0)\n                continue;\n            const nx = sx / diag;\n            const ny = sy / diag;\n            const d = Math.hypot(nx - flat[i].x, ny - flat[i].y);\n            if (d > maxDelta)\n                maxDelta = d;\n            flat[i] = { x: nx, y: ny };\n        }\n    }\n    return maxDelta;\n}\nfunction factorSystem(adj, nv) {\n    const n = nv - 1;\n    if (n <= 0)\n        return null;\n    let b = 0;\n    for (let i = 1; i < nv; i++) {\n        for (const e of adj[i]) {\n            if (e.j === 0)\n                continue;\n            const d = Math.abs(i - e.j);\n            if (d > b)\n                b = d;\n        }\n    }\n    if (b >= n)\n        return null;\n    const a = new Float64Array(n * (b + 1));\n    for (let i = 1; i < nv; i++) {\n        const r = i - 1;\n        for (const e of adj[i]) {\n            a[r * (b + 1)] += e.w;\n            if (e.j === 0)\n                continue;\n            const c = e.j - 1;\n            if (c < r)\n                a[r * (b + 1) + (r - c)] -= e.w;\n        }\n    }\n    const envelope = new Int32Array(n);\n    for (let r = 0; r < n; r++) {\n        const top = Math.min(b, r);\n        for (let k = top; k >= 1; k--) {\n            if (a[r * (b + 1) + k] !== 0) {\n                envelope[r] = k;\n                break;\n            }\n        }\n    }\n    for (let i = 0; i < n; i++) {\n        const wi = envelope[i];\n        for (let k = wi; k >= 1; k--) {\n            const j = i - k;\n            if (j < 0)\n                continue;\n            let s = a[i * (b + 1) + k];\n            const top = Math.min(wi - k, envelope[j]);\n            for (let m = 1; m <= top; m++) {\n                s -= a[i * (b + 1) + (k + m)] * a[j * (b + 1) + m];\n            }\n            a[i * (b + 1) + k] = s / a[j * (b + 1)];\n        }\n        let d = a[i * (b + 1)];\n        for (let k = 1; k <= wi; k++) {\n            d -= a[i * (b + 1) + k] * a[i * (b + 1) + k];\n        }\n        if (!(d > 0))\n            return null;\n        a[i * (b + 1)] = Math.sqrt(d);\n    }\n    return { n, b, a, envelope };\n}\nfunction solveBanded(m, rx, ry) {\n    const { n, b, a, envelope } = m;\n    const w = b + 1;\n    for (let i = 0; i < n; i++) {\n        let sx = rx[i];\n        let sy = ry[i];\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            sx -= v * rx[i - k];\n            sy -= v * ry[i - k];\n        }\n        const d = a[i * w];\n        rx[i] = sx / d;\n        ry[i] = sy / d;\n    }\n    for (let i = n - 1; i >= 0; i--) {\n        const d = a[i * w];\n        const vx = rx[i] / d;\n        const vy = ry[i] / d;\n        rx[i] = vx;\n        ry[i] = vy;\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            rx[i - k] -= v * vx;\n            ry[i - k] -= v * vy;\n        }\n    }\n}\nfunction intrinsicScale(tris) {\n    let area = 0;\n    for (const tri of tris)\n        area += tri.area;\n    return area > 0 ? Math.sqrt(area) : 1;\n}\nexport function buildTris(mesh) {\n    const out = [];\n    for (const [a, b, c] of mesh.tris) {\n        const A = mesh.positions[a];\n        const B = mesh.positions[b];\n        const C = mesh.positions[c];\n        const ux = B.x - A.x, uy = B.y - A.y, uz = B.z - A.z;\n        const vx = C.x - A.x, vy = C.y - A.y, vz = C.z - A.z;\n        const cx = uy * vz - uz * vy;\n        const cy = uz * vx - ux * vz;\n        const cz = ux * vy - uy * vx;\n        const cross = Math.hypot(cx, cy, cz);\n        const la = Math.hypot(ux, uy, uz);\n        const lb = Math.hypot(vx, vy, vz);\n        if (la === 0 || lb === 0)\n            continue;\n        const cos = Math.max(-1, Math.min(1, (ux * vx + uy * vy + uz * vz) / (la * lb)));\n        out.push({\n            ids: [a, b, c],\n            xs: [\n                { x: 0, y: 0 },\n                { x: la, y: 0 },\n                { x: lb * cos, y: lb * Math.sqrt(Math.max(0, 1 - cos * cos)) },\n            ],\n            area: cross / 2,\n        });\n    }\n    return out;\n}\nexport function energyOf(flat, tris) {\n    let e = 0;\n    let area = 0;\n    for (const tri of tris) {\n        const { ids, xs } = tri;\n        for (let k = 0; k < 3; k++) {\n            const p = k;\n            const q = (k + 1) % 3;\n            const lc = Math.hypot(xs[q].x - xs[p].x, xs[q].y - xs[p].y);\n            const lq = Math.hypot(flat[ids[q]].x - flat[ids[p]].x, flat[ids[q]].y - flat[ids[p]].y);\n            e += (lq - lc) * (lq - lc);\n        }\n        area += tri.area;\n    }\n    return area > 0 ? e / area : 0;\n}\nexport function placeByUnfolding(mesh, tris) {\n    const nv = mesh.positions.length;\n    const flat = new Array(nv);\n    const placed = new Array(nv).fill(false);\n    const incident = [];\n    for (let i = 0; i < nv; i++)\n        incident.push([]);\n    tris.forEach((tri, t) => {\n        for (const id of tri.ids)\n            incident[id].push(t);\n    });\n    const seed = tris[0];\n    seed.ids.forEach((id, k) => {\n        flat[id] = { x: seed.xs[k].x, y: seed.xs[k].y };\n        placed[id] = true;\n    });\n    const queue = seed.ids.flatMap((id) => incident[id]);\n    for (let head = 0; head < queue.length; head++) {\n        const tri = tris[queue[head]];\n        const open = tri.ids.filter((i) => !placed[i]);\n        if (open.length !== 1)\n            continue;\n        const v = open[0];\n        const p = placeFrom(bestHinge(v, incident[v], tris, placed, tri), v, flat, placed);\n        if (!p)\n            continue;\n        flat[v] = p;\n        placed[v] = true;\n        for (const t of incident[v])\n            queue.push(t);\n    }\n    for (let i = 0; i < nv; i++) {\n        if (!placed[i])\n            console.warn(`unroll: vertex ${i} of ${nv} is not connected to the mesh`);\n    }\n    return flat;\n}\nfunction bestHinge(v, candidates, tris, placed, fallback) {\n    let best = fallback;\n    let bestScore = -Infinity;\n    for (const t of candidates) {\n        const tri = tris[t];\n        const k = tri.ids.indexOf(v);\n        if (k < 0)\n            continue;\n        const i = (k + 1) % 3;\n        const j = (k + 2) % 3;\n        if (!placed[tri.ids[i]] || !placed[tri.ids[j]])\n            continue;\n        const edge = sq(tri.xs[j].x - tri.xs[i].x, tri.xs[j].y - tri.xs[i].y);\n        const reach = sq(tri.xs[k].x - tri.xs[i].x, tri.xs[k].y - tri.xs[i].y);\n        const score = reach > 0 ? edge / reach : Infinity;\n        if (score > bestScore) {\n            bestScore = score;\n            best = tri;\n        }\n    }\n    return best;\n}\nfunction sq(dx, dy) {\n    return dx * dx + dy * dy;\n}\nfunction placeFrom(tri, v, flat, placed) {\n    const { ids, xs } = tri;\n    const k = ids.indexOf(v);\n    const i = (k + 1) % 3;\n    const j = (k + 2) % 3;\n    if (!placed[ids[i]] || !placed[ids[j]])\n        return null;\n    const dx = xs[j].x - xs[i].x;\n    const dy = xs[j].y - xs[i].y;\n    const den = dx * dx + dy * dy;\n    if (den < 1e-12)\n        return null;\n    const ex = flat[ids[j]].x - flat[ids[i]].x;\n    const ey = flat[ids[j]].y - flat[ids[i]].y;\n    const sr = (ex * dx + ey * dy) / den;\n    const si = (ey * dx - ex * dy) / den;\n    const norm = Math.hypot(sr, si);\n    if (norm < 1e-12)\n        return null;\n    const cr = sr / norm;\n    const ci = si / norm;\n    const vx = xs[k].x - xs[i].x;\n    const vy = xs[k].y - xs[i].y;\n    return {\n        x: flat[ids[i]].x + cr * vx - ci * vy,\n        y: flat[ids[i]].y + ci * vx + cr * vy,\n    };\n}\nexport function canonicalise(flat) {\n    if (flat.length === 0)\n        return flat;\n    let cx = 0;\n    let cy = 0;\n    for (const p of flat) {\n        cx += p.x;\n        cy += p.y;\n    }\n    cx /= flat.length;\n    cy /= flat.length;\n    let sxx = 0;\n    let sxy = 0;\n    let syy = 0;\n    for (const p of flat) {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        sxx += dx * dx;\n        sxy += dx * dy;\n        syy += dy * dy;\n    }\n    const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy);\n    const co = Math.cos(-ang);\n    const si = Math.sin(-ang);\n    let minX = Infinity;\n    let minY = Infinity;\n    const out = flat.map((p) => {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        const q = { x: co * dx - si * dy, y: si * dx + co * dy };\n        if (q.x < minX)\n            minX = q.x;\n        if (q.y < minY)\n            minY = q.y;\n        return q;\n    });\n    for (const q of out) {\n        q.x -= minX;\n        q.y -= minY;\n    }\n    return out;\n}\nexport function boundaryEdges(mesh) {\n    const used = new Map();\n    const key = (a, b) => (a < b ? `${a}-${b}` : `${b}-${a}`);\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1);\n        }\n    }\n    const out = [];\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            if (used.get(key(u, v)) === 1)\n                out.push([u, v]);\n        }\n    }\n    return out;\n}\nexport function chainEdges(edges) {\n    const next = new Map();\n    const hasPredecessor = new Set();\n    for (const [u, v] of edges) {\n        next.set(u, v);\n        hasPredecessor.add(v);\n    }\n    const chains = [];\n    const visited = new Set();\n    const walk = (seed) => {\n        const chain = [seed];\n        visited.add(seed);\n        let cur = seed;\n        while (true) {\n            const to = next.get(cur);\n            if (to === undefined || to === seed)\n                break;\n            if (visited.has(to))\n                break;\n            chain.push(to);\n            visited.add(to);\n            cur = to;\n        }\n        if (next.get(cur) === seed && chain.length > 2)\n            chain.push(seed);\n        if (chain.length > 1)\n            chains.push(chain);\n    };\n    for (const [u] of next)\n        if (!hasPredecessor.has(u))\n            walk(u);\n    for (const [u] of next)\n        if (!visited.has(u))\n            walk(u);\n    return chains;\n}\nexport function boundaryLoop(mesh) {\n    const chains = chainEdges(boundaryEdges(mesh));\n    if (chains.length === 0)\n        return [];\n    return chains.map((loop) => {\n        return loop[0] === loop[loop.length - 1] ? loop.slice(0, -1) : loop;\n    });\n}\nexport function measureDistortion(mesh, flat) {\n    let squared = 0;\n    let count = 0;\n    let edgeMax = 0;\n    let area3d = 0;\n    let area2d = 0;\n    const triStrains = [];\n    for (const [a, b, c] of mesh.tris) {\n        const local = flattenTriangle(mesh, a, b, c);\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            const length3d = distance3d(mesh, u, v);\n            if (length3d === 0)\n                continue;\n            const p = flat.positions[u];\n            const q = flat.positions[v];\n            const ratio = Math.hypot(q.x - p.x, q.y - p.y) / length3d - 1;\n            squared += ratio * ratio;\n            count += 1;\n            edgeMax = Math.max(edgeMax, Math.abs(ratio));\n        }\n        area3d += local.area;\n        area2d += Math.abs(signedArea(flat.positions[a], flat.positions[b], flat.positions[c]));\n        triStrains.push(principalStrains(local, flat, a, b, c));\n    }\n    return {\n        edgeRms: count > 0 ? Math.sqrt(squared / count) : 0,\n        edgeMax,\n        areaRatio: area3d > 0 ? area2d / area3d : 1,\n        triStrains,\n    };\n}\nfunction flattenTriangle(mesh, a, b, c) {\n    const A = mesh.positions[a];\n    const B = mesh.positions[b];\n    const C = mesh.positions[c];\n    const ex = B.x - A.x, ey = B.y - A.y, ez = B.z - A.z;\n    const fx = C.x - A.x, fy = C.y - A.y, fz = C.z - A.z;\n    const ux = Math.hypot(ex, ey, ez);\n    const dot = ux > 0 ? (ex * fx + ey * fy + ez * fz) / ux : 0;\n    const nx = ey * fz - ez * fy;\n    const ny = ez * fx - ex * fz;\n    const nz = ex * fy - ey * fx;\n    const cross = Math.hypot(nx, ny, nz);\n    return { ux, vx: dot, vy: ux > 0 ? cross / ux : 0, area: cross / 2 };\n}\nfunction principalStrains(local, flat, a, b, c) {\n    const det = local.ux * local.vy;\n    if (det === 0)\n        return { e1: 0, e2: 0 };\n    const A = flat.positions[a];\n    const B = flat.positions[b];\n    const C = flat.positions[c];\n    const qx1 = B.x - A.x, qy1 = B.y - A.y;\n    const qx2 = C.x - A.x, qy2 = C.y - A.y;\n    const i00 = local.vy / det;\n    const i01 = -local.vx / det;\n    const i11 = local.ux / det;\n    const j00 = qx1 * i00;\n    const j01 = qx1 * i01 + qx2 * i11;\n    const j10 = qy1 * i00;\n    const j11 = qy1 * i01 + qy2 * i11;\n    const e = (j00 + j11) / 2;\n    const f = (j00 - j11) / 2;\n    const g = (j10 + j01) / 2;\n    const h = (j10 - j01) / 2;\n    const q = Math.hypot(e, h);\n    const r = Math.hypot(f, g);\n    const sigma1 = q + r;\n    const sigma2 = Math.abs(q - r);\n    // sigma1 >= sigma2, so e1 (tension) is always >= e2 (compression)\n    return { e1: sigma1 - 1, e2: sigma2 - 1 };\n}\nfunction signedArea(a, b, c) {\n    return ((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)) / 2;\n}\nfunction distance3d(mesh, u, v) {\n    const p = mesh.positions[u];\n    const q = mesh.positions[v];\n    return Math.hypot(q.x - p.x, q.y - p.y, q.z - p.z);\n}\n"
    },
